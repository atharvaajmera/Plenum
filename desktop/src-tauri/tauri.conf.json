{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plenum",
  "version": "0.3.0",
  "identifier": "com.plenum.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plenum",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss: https: http:; font-src 'self' data:;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/atharvaajmera/Plenum/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NUQzNzY3ODlFOTkxNDMKUldSRGtlbUpaemRkdG9hY1IxcnByR2JwdlA1L0h3NlRuVzZOT0tsWmgrRVRuVHA2d3kwVFVPbW4K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
